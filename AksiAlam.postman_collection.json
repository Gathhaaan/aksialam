							"raw": "{\n  \"title\": \"Bersih Pantai Kenjeran 2026\",\n  \"description\": \"Aksi gotong royong membersihkan sampah plastik di pesisir Kenjeran\",\n  \"event_date\": \"2026-07-15\",\n  \"max_volunteers\": 50,\n  \"target_metric\": 500,\n  \"metric_unit\": \"kg sampah\",\n  \"report_id\": 1\n}"
