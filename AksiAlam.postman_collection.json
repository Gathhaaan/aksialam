{
	"info": {
		"_postman_id": "aksialam-api-v1",
		"name": "AksiAlam API v1",
		"description": "Koleksi API untuk platform AksiAlam — Gotong Royong Digital untuk Restorasi Ekologi Indonesia.\n\nMetode autentikasi:\n1. JWT Bearer Token (untuk CRUD)\n2. API Key via header X-API-KEY (untuk statistik)\n3. Basic Auth (login email + password)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api/v1" },
		{ "key": "token", "value": "" },
		{ "key": "api_key", "value": "aksialam-api-key-2026-secret" }
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@aksialam.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
					}
				},
				{
					"name": "Login (User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"    console.log('Token saved!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"gathan@user.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Login (Organizer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"org@himafortic.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@aksialam.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
					}
				}
			]
		},
		{
			"name": "2. Reports (Laporan)",
			"item": [
				{
					"name": "List All Reports",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] }
					}
				},
				{
					"name": "List Reports (Filter: Sampah)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/reports?category=sampah",
							"host": ["{{base_url}}"],
							"path": ["reports"],
							"query": [{ "key": "category", "value": "sampah" }]
						}
					}
				},
				{
					"name": "List Reports (Search)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/reports?q=kali",
							"host": ["{{base_url}}"],
							"path": ["reports"],
							"query": [{ "key": "q", "value": "kali" }]
						}
					}
				},
				{
					"name": "List Reports (Filter: Status Verified)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/reports?status=verified",
							"host": ["{{base_url}}"],
							"path": ["reports"],
							"query": [{ "key": "status", "value": "verified" }]
						}
					}
				},
				{
					"name": "Show Report Detail",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/reports/1", "host": ["{{base_url}}"], "path": ["reports", "1"] }
					}
				},
				{
					"name": "Create Report (JWT)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Sampah Berserakan di Taman Kota\",\n  \"description\": \"Ditemukan sampah plastik dan botol kaca berserakan di area taman kota.\",\n  \"category\": \"sampah\",\n  \"location_name\": \"Taman Bungkul, Surabaya\"\n}"
						},
						"url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] }
					}
				},
				{
					"name": "Update Report (JWT, Owner)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"[UPDATED] Sampah Berserakan di Taman Kota\",\n  \"description\": \"Update: kondisi semakin parah setelah hujan deras.\"\n}"
						},
						"url": { "raw": "{{base_url}}/reports/1", "host": ["{{base_url}}"], "path": ["reports", "1"] }
					}
				},
				{
					"name": "Delete Report (JWT, Owner/Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/reports/1", "host": ["{{base_url}}"], "path": ["reports", "1"] }
					}
				}
			]
		},
		{
			"name": "3. Campaigns (Kampanye)",
			"item": [
				{
					"name": "List All Campaigns",
					"request": {
						"method": "GET",
						"header": [
